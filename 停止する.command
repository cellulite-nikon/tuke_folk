#!/bin/bash
# ----------------------------------------------------
# 🛑 飲み会ツケ管理アプリ 停止スクリプト
# Finderでダブルクリックするだけでサーバーを安全に停止します
# ----------------------------------------------------

cd "$(dirname "$0")"

clear
PORT=8765
PID=$(lsof -ti :$PORT 2>/dev/null)

echo "======================================================"
if [ -n "$PID" ]; then
    kill -9 $PID 2>/dev/null
    echo " 🛑 ツケ管理アプリのサーバーを停止しました！"
    echo "    (プロセスID: $PID を終了しました)"
else
    echo " ℹ️ サーバーは起動していませんでした。"
fi
echo "======================================================"
echo ""
echo "このウィンドウは閉じて構いません。"
sleep 2
